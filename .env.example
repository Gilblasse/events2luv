# Copy to .env. Keep this file private. Production needs an HTTPS reverse proxy.
APP_ORIGIN=https://events2luv.com
# Set only when the host's reverse proxy is trusted; e.g. loopback for local nginx.
TRUST_PROXY=
# Optional mail notifications. Requests always appear in the authenticated admin inbox.
SMTP_URL=
MAIL_FROM=
INQUIRY_TO=events2luv@gmail.com
